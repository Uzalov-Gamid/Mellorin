{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mellorin today v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "tasks": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[\\p{L}\\p{N}_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[\\p{L}\\p{N}_-]+$"
          },
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "time": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "done": {
            "type": "boolean"
          },
          "completedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "title",
          "subject",
          "done"
        ]
      }
    }
  },
  "required": [
    "version",
    "date",
    "tasks"
  ]
}
