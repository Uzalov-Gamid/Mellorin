{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mellorin state v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "subjects": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[\\p{L}\\p{N}_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "next": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "trail": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[\\p{L}\\p{N}_-]+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "status": {
                  "enum": [
                    "passed",
                    "current",
                    "future"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "id",
                "label",
                "status"
              ]
            }
          },
          "tails": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              },
              "required": [
                "title"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "trail"
        ]
      }
    },
    "dates": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "sessions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[\\p{L}\\p{N}_-]+$"
          },
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "date",
          "subject"
        ]
      }
    },
    "repeats": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[\\p{L}\\p{N}_-]+$"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "screen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "title",
          "subject"
        ]
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[\\p{L}\\p{N}_-]+$"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "screen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "title",
          "subject",
          "count"
        ]
      }
    }
  },
  "required": [
    "version",
    "subjects"
  ]
}
